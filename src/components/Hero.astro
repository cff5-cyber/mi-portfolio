---
import { site } from '../data/site';
---

<section class="relative mx-auto flex max-w-4xl flex-col items-center px-6 pb-20 pt-32 text-center md:pb-28 md:pt-40">
  <!-- Background ambient glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-1/4 h-[500px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[rgb(var(--accent))] opacity-10 blur-[120px]"></div>
    <div class="absolute right-1/4 top-1/3 h-[350px] w-[350px] rounded-full bg-[rgb(var(--accent-secondary))] opacity-[0.08] blur-[100px]"></div>
  </div>

  <div class="relative flex flex-col items-center">
    <!-- Availability badge -->
    <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 backdrop-blur-md">
      <span class="relative flex h-2 w-2">
        <span class="animate-pulse-dot absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <span class="text-xs font-semibold tracking-wide text-emerald-600 dark:text-emerald-400">
        Disponible para trabajar
      </span>
    </div>

    <!-- Role -->
    <p class="animate-fade-in-up-1 mb-3 font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">
      {site.role}
    </p>

    <!-- Name -->
    <h1 class="animate-fade-in-up-2 text-gradient text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
      {site.name}
    </h1>

    <!-- Tagline -->
    <p class="animate-fade-in-up-3 mt-6 max-w-2xl text-base leading-relaxed text-[var(--text-muted)] sm:text-lg md:text-xl">
      {site.tagline}
    </p>

    <!-- CTAs -->
    <div class="animate-fade-in-up-4 mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#experience"
        class="group relative inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[rgb(var(--accent))] to-[rgb(var(--accent-secondary))] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-[rgb(var(--accent)_/_0.25)] transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-[rgb(var(--accent)_/_0.35)] active:scale-95"
      >
        Ver proyectos
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
      <a
        href="#contact"
        class="glass rounded-full px-7 py-3 text-sm font-medium text-[var(--text-main)] transition-all duration-300 hover:scale-105 hover:border-[rgb(var(--accent)_/_0.4)] active:scale-95"
      >
        Contactar
      </a>
    </div>

    <!-- Quick info cards -->
    <div class="animate-fade-in-up-4 mt-16 grid w-full gap-4 sm:grid-cols-3">
      <div class="glass flex flex-col items-center rounded-2xl p-4 text-center transition-all duration-300 hover:border-[rgb(var(--accent)_/_0.3)]">
        <span class="text-xl" aria-hidden="true">⚡</span>
        <span class="mt-2 text-xs font-mono font-medium text-[var(--text-subtle)] uppercase">Stack Principal</span>
        <span class="mt-1 text-sm font-semibold text-[var(--text-main)]">Astro · React · Python</span>
      </div>

      <div class="glass flex flex-col items-center rounded-2xl p-4 text-center transition-all duration-300 hover:border-[rgb(var(--accent)_/_0.3)]">
        <span class="text-xl" aria-hidden="true">🎯</span>
        <span class="mt-2 text-xs font-mono font-medium text-[var(--text-subtle)] uppercase">Especialidad</span>
        <span class="mt-1 text-sm font-semibold text-[var(--text-main)]">Desarrollo Frontend & Backend</span>
      </div>

      <div class="glass flex flex-col items-center rounded-2xl p-4 text-center transition-all duration-300 hover:border-[rgb(var(--accent)_/_0.3)]">
        <span class="text-xl" aria-hidden="true">📍</span>
        <span class="mt-2 text-xs font-mono font-medium text-[var(--text-subtle)] uppercase">Ubicación</span>
        <span class="mt-1 text-sm font-semibold text-[var(--text-main)]">{site.location}</span>
      </div>
    </div>
  </div>
</section>
