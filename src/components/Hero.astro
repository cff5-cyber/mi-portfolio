---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.jpg';
---

<section class="relative mx-auto flex max-w-5xl flex-col-reverse items-center gap-12 px-6 pb-28 pt-36 md:flex-row md:gap-16 md:pt-44">
  <!-- Background glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-1/3 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[rgb(var(--accent-secondary))] opacity-[0.04] blur-[100px]"></div>
  </div>

  <div class="relative flex-1 text-center md:text-left">
    <!-- Available badge -->
    <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-3.5 py-1.5">
      <span class="relative flex h-2 w-2">
        <span class="animate-pulse-dot absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <span class="text-xs font-medium text-emerald-400">Disponible para trabajar</span>
    </div>

    <!-- Role -->
    <p class="animate-fade-in-up-1 mb-3 font-mono text-sm font-medium tracking-wide text-stone-500 uppercase">
      {site.role}
    </p>

    <!-- Name -->
    <h1 class="animate-fade-in-up-2 text-gradient text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
      {site.name}
    </h1>

    <!-- Tagline -->
    <p class="animate-fade-in-up-3 mt-6 max-w-lg text-lg leading-relaxed text-stone-400">
      {site.tagline}
    </p>

    <!-- CTA buttons -->
    <div class="animate-fade-in-up-4 mt-10 flex flex-wrap items-center justify-center gap-4 md:justify-start">
      <a
        href="#projects"
        class="group relative inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[rgb(var(--accent))] to-[rgb(var(--accent-secondary))] px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-[rgb(var(--accent)_/_0.25)] transition-all duration-300 hover:shadow-xl hover:shadow-[rgb(var(--accent)_/_0.35)] hover:brightness-110"
      >
        Ver proyectos
        <span class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="#contact"
        class="rounded-full border border-stone-700 px-6 py-2.5 text-sm font-medium text-stone-300 transition-all duration-300 hover:border-stone-500 hover:bg-stone-800/40 hover:text-stone-100"
      >
        Contactar
      </a>
    </div>
  </div>

  <!-- Profile image with animated orb -->
  <div class="animate-fade-in-up relative shrink-0">
    <div class="animate-float relative">
      <!-- Animated gradient orb -->
      <div class="absolute -inset-6 animate-spin-slow rounded-full bg-gradient-to-tr from-[rgb(var(--accent))] via-[rgb(var(--accent-secondary))] to-[rgb(var(--accent-tertiary))] opacity-20 blur-2xl" aria-hidden="true"></div>
      <div class="absolute -inset-3 rounded-full bg-gradient-to-br from-[rgb(var(--accent)_/_0.15)] to-[rgb(var(--accent-tertiary)_/_0.15)]" aria-hidden="true"></div>
      <Image
        src={profileImage}
        alt={`Foto de perfil de ${site.name}`}
        width={280}
        height={280}
        class="relative size-56 rounded-full object-cover object-top ring-2 ring-stone-700/50 ring-offset-2 ring-offset-stone-950 md:size-72"
        loading="eager"
      />
    </div>
  </div>
</section>
