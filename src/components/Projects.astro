---
import { projects } from '../data/site';
---

<section id="projects" class="border-t border-stone-800/80 bg-stone-900/40">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="text-sm font-medium tracking-wide text-stone-500 uppercase">Proyectos</h2>
    <p class="mt-3 max-w-xl text-stone-400">
      Una selección de proyectos donde he aplicado desarrollo frontend y soluciones web completas.
    </p>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        projects.map((project) => (
          <article class="group flex flex-col rounded-2xl border border-stone-800 bg-stone-900 p-6 transition hover:border-stone-700 hover:bg-stone-900/80">
            <h3 class="text-lg font-medium text-stone-100">{project.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-400">
              {project.description}
            </p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                project.tags.map((tag) => (
                  <li class="rounded-full bg-stone-950 px-2.5 py-0.5 text-xs text-stone-500 ring-1 ring-stone-700">
                    {tag}
                  </li>
                ))
              }
            </ul>
            <div class="mt-6 flex gap-4 text-sm">
              {
                project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-stone-100 transition hover:text-stone-400"
                  >
                    Ver proyecto →
                  </a>
                )
              }
              {
                project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-stone-500 transition hover:text-stone-100"
                  >
                    GitHub
                  </a>
                )
              }
              {
                !project.url && !project.github && (
                  <span class="text-stone-600">Enlace próximamente</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
