---
import { projects } from '../data/site';
---

<section id="projects" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="font-mono text-sm font-medium tracking-wide text-[rgb(var(--accent))] uppercase">Proyectos</h2>
    <p class="mt-3 max-w-xl text-stone-400">
      Una selección de proyectos donde he aplicado desarrollo frontend y soluciones web completas.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        projects.map((project, i) => (
          <article class="card-gradient-border group flex flex-col rounded-2xl p-6 transition-all duration-300 hover:translate-y-[-2px]">
            {/* Project number */}
            <span class="font-mono text-xs text-stone-600/60" aria-hidden="true">
              #{String(i + 1).padStart(2, '0')}
            </span>

            <h3 class="mt-3 text-lg font-semibold text-stone-100 transition-colors group-hover:text-white">
              {project.title}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-400">
              {project.description}
            </p>

            {/* Tags */}
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                project.tags.map((tag) => (
                  <li class="badge-shine rounded-full border border-stone-700/50 bg-stone-900/60 px-2.5 py-0.5 font-mono text-xs text-[rgb(var(--accent)_/_0.7)] transition-colors group-hover:border-[rgb(var(--accent)_/_0.3)] group-hover:text-[rgb(var(--accent)_/_0.9)]">
                    {tag}
                  </li>
                ))
              }
            </ul>

            {/* Links */}
            <div class="mt-6 flex gap-4 text-sm">
              {
                project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline-gradient inline-flex items-center gap-1 font-medium text-stone-200 transition-colors hover:text-white"
                  >
                    Ver proyecto
                    <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                  </a>
                )
              }
              {
                project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-stone-500 transition-colors hover:text-stone-200"
                  >
                    GitHub
                  </a>
                )
              }
              {
                !project.url && !project.github && (
                  <span class="font-mono text-xs text-stone-600">Próximamente</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
