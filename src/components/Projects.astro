---
import { projects } from '../data/site';
import { techDetails } from '../data/tech';
---

<section id="experience" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
    <h2 class="flex items-center gap-2 font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">
      <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      Experiencia en proyectos
    </h2>
    <p class="mt-3 max-w-xl text-[var(--text-muted)]">
      Proyectos con los que he aplicado desarrollo frontend y soluciones web completas.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        projects.map((project, i) => (
          <article class="card-gradient-border group flex flex-col rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1">
            {/* Project Image */}
            {
              ('image' in project && project.image) && (
                <div class="mb-5 aspect-video w-full overflow-hidden rounded-xl border border-[rgb(var(--accent)_/_0.15)] shadow-sm">
                  <img
                    src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${project.image}`}
                    alt={`Captura de pantalla de ${project.title}`}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )
            }

            {/* Project number */}
            <span class="font-mono text-xs font-semibold text-[var(--text-subtle)]" aria-hidden="true">
              #{String(i + 1).padStart(2, '0')}
            </span>

            <h3 class="mt-3 text-lg font-bold text-[var(--text-main)] transition-colors group-hover:text-[rgb(var(--accent))]">
              {project.title}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--text-muted)]">
              {project.description}
            </p>

            {/* Tags */}
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                project.tags.map((tag) => {
                  const tech = techDetails[tag];
                  if (!tech) return (
                    <li class="badge-shine rounded-full border px-2.5 py-0.5 font-mono text-xs font-medium text-[rgb(var(--accent))] transition-colors group-hover:border-[rgb(var(--accent)_/_0.4)]">
                      {tag}
                    </li>
                  );
                  return (
                    <li 
                      class="flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-sans text-xs font-semibold shadow-sm transition-transform hover:scale-105"
                      style={`background-color: ${tech.color}15; color: ${tech.color}; border-color: ${tech.color}40;`}
                    >
                      <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={tech.iconSvg} />
                      {tag}
                    </li>
                  );
                })
              }
            </ul>

            {/* Links */}
            <div class="mt-6 flex gap-4 text-sm">
              {
                project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline-gradient inline-flex items-center gap-1 font-semibold text-[var(--text-main)] transition-colors hover:text-[rgb(var(--accent))]"
                  >
                    Ver proyecto
                    <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                  </a>
                )
              }
              {
                project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-subtle)] transition-colors hover:text-[var(--text-main)]"
                  >
                    GitHub
                  </a>
                )
              }
              {
                !project.url && !project.github && (
                  <span class="font-mono text-xs font-medium text-[var(--text-subtle)]">Próximamente</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
