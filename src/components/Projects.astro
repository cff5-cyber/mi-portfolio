---
import { projects } from '../data/site';
---

<section id="experience" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
    <h2 class="font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">Experiencia en proyectos</h2>
    <p class="mt-3 max-w-xl text-[var(--text-muted)]">
      Proyectos con los que he aplicado desarrollo frontend y soluciones web completas.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        projects.map((project, i) => (
          <article class="card-gradient-border group flex flex-col rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1">
            {/* Project Image */}
            {
              ('image' in project && project.image) && (
                <div class="mb-5 aspect-video w-full overflow-hidden rounded-xl border border-[rgb(var(--accent)_/_0.15)] shadow-sm">
                  <img
                    src={project.image as string}
                    alt={`Captura de pantalla de ${project.title}`}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )
            }

            {/* Project number */}
            <span class="font-mono text-xs font-semibold text-[var(--text-subtle)]" aria-hidden="true">
              #{String(i + 1).padStart(2, '0')}
            </span>

            <h3 class="mt-3 text-lg font-bold text-[var(--text-main)] transition-colors group-hover:text-[rgb(var(--accent))]">
              {project.title}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--text-muted)]">
              {project.description}
            </p>

            {/* Tags */}
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                project.tags.map((tag) => (
                  <li class="badge-shine rounded-full border px-2.5 py-0.5 font-mono text-xs font-medium text-[rgb(var(--accent))] transition-colors group-hover:border-[rgb(var(--accent)_/_0.4)]">
                    {tag}
                  </li>
                ))
              }
            </ul>

            {/* Links */}
            <div class="mt-6 flex gap-4 text-sm">
              {
                project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline-gradient inline-flex items-center gap-1 font-semibold text-[var(--text-main)] transition-colors hover:text-[rgb(var(--accent))]"
                  >
                    Ver proyecto
                    <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                  </a>
                )
              }
              {
                project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-subtle)] transition-colors hover:text-[var(--text-main)]"
                  >
                    GitHub
                  </a>
                )
              }
              {
                !project.url && !project.github && (
                  <span class="font-mono text-xs font-medium text-[var(--text-subtle)]">Próximamente</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
