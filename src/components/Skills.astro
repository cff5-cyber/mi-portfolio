---
import { skills } from '../data/site';
---

<section class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
    <h2 class="font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">Tecnologías</h2>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        skills.map((skill) => (
          <li class="badge-shine rounded-full border px-5 py-2.5 font-mono text-sm font-medium text-[var(--text-muted)] transition-all duration-300 hover:scale-105 hover:border-[rgb(var(--accent)_/_0.5)] hover:text-[var(--text-main)] hover:shadow-md hover:shadow-[rgb(var(--accent)_/_0.12)]">
            {skill}
          </li>
        ))
      }
    </ul>
  </div>
</section>
