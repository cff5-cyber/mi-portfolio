---
import { skills } from '../data/site';
---

<section class="border-t border-stone-800/80">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="text-sm font-medium tracking-wide text-stone-500 uppercase">Tecnologías</h2>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        skills.map((skill) => (
          <li class="rounded-full border border-stone-800 px-4 py-1.5 text-sm text-stone-400">
            {skill}
          </li>
        ))
      }
    </ul>
  </div>
</section>
