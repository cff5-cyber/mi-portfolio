---
import { site } from '../data/site';
---

<section id="contact" class="border-t border-stone-800/80 bg-stone-900/40">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="text-sm font-medium tracking-wide text-stone-500 uppercase">Contacto</h2>
    <p class="mt-3 max-w-md text-stone-400">
      ¿Tienes un proyecto en mente? Escríbeme y hablamos.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
      <a
        href={`mailto:${site.email}`}
        class="text-lg font-medium text-stone-100 transition hover:text-stone-400"
      >
        {site.email}
      </a>
      <span class="hidden text-stone-700 sm:inline">·</span>
      <a
        href={`tel:${site.phone.replace(/\s/g, '')}`}
        class="text-stone-400 transition hover:text-stone-100"
      >
        {site.phone}
      </a>
      <span class="hidden text-stone-700 sm:inline">·</span>
      <span class="text-stone-500">{site.location}</span>
    </div>

    <a
      href={site.cvUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-stone-400 transition hover:text-stone-100"
    >
      Descargar CV
      <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<footer class="border-t border-stone-800/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-8">
    <p class="text-sm text-stone-600">
      © {new Date().getFullYear()} {site.name}
    </p>
    <p class="text-sm text-stone-600">Hecho con Astro & Tailwind</p>
  </div>
</footer>
