---
import { site } from '../data/site';
---

<section id="contact" class="section-divider relative overflow-hidden">
  <!-- Background accent glow -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute bottom-0 left-1/2 h-[400px] w-[600px] -translate-x-1/2 translate-y-1/2 rounded-full bg-[rgb(var(--accent))] opacity-10 blur-[100px]"></div>
  </div>

  <div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
    <h2 class="flex items-center gap-2 font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">
      <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      Contacto
    </h2>

    <p class="text-gradient mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
      ¿Hablamos?
    </p>
    <p class="mt-4 max-w-md text-base text-[var(--text-muted)]">
      Estoy abierto a nuevas oportunidades y colaboraciones. Escríbeme y hablemos de tu proyecto.
    </p>

    <div class="mt-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
      <a
        href={`mailto:${site.email}`}
        class="link-underline-gradient text-lg font-semibold text-[var(--text-main)] transition-colors hover:text-[rgb(var(--accent))]">
        {site.email}
      </a>
      <span class="hidden text-[var(--text-subtle)] opacity-40 sm:inline" aria-hidden="true">│</span>
      <a
        href={`tel:${site.phone.replace(/\s/g, '')}`}
        class="text-base text-[var(--text-muted)] transition-colors hover:text-[var(--text-main)]">
        {site.phone}
      </a>
      <span class="hidden text-[var(--text-subtle)] opacity-40 sm:inline" aria-hidden="true">│</span>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-base text-[var(--text-muted)] transition-colors hover:text-[#0A66C2]">
        LinkedIn
      </a>
    </div>
  </div>
</section>

<footer class="border-t border-[var(--border-color)]">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-6 py-8 sm:flex-row">
    <p class="font-mono text-xs text-[var(--text-subtle)]">
      © {new Date().getFullYear()} {site.name}
    </p>
    <p class="font-mono text-xs text-[var(--text-subtle)]">
      Hecho con <span class="text-[rgb(var(--accent))]">♥</span> usando Astro & Tailwind
    </p>
  </div>
</footer>
