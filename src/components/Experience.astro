---
import { experience } from '../data/site';
---

<section id="experience" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="font-mono text-sm font-medium tracking-wide text-[rgb(var(--accent))] uppercase">Experiencia</h2>

    <div class="relative mt-12">
      <!-- Timeline line -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-gradient-to-b from-[rgb(var(--accent)_/_0.4)] via-stone-700/40 to-transparent md:left-[99px]" aria-hidden="true"></div>

      <div class="space-y-12">
        {
          experience.map((item, i) => (
            <article class="group relative grid gap-4 pl-8 md:grid-cols-[200px_1fr] md:gap-8 md:pl-0">
              {/* Timeline dot */}
              <div class="absolute left-0 top-1.5 flex h-[15px] w-[15px] items-center justify-center md:left-[92px]" aria-hidden="true">
                <div class="h-3 w-3 rounded-full border-2 border-[rgb(var(--accent)_/_0.5)] bg-stone-950 transition-colors group-hover:border-[rgb(var(--accent))] group-hover:bg-[rgb(var(--accent)_/_0.2)]"></div>
              </div>

              <div class="md:text-right">
                <p class="font-mono text-sm text-stone-600">{item.period}</p>
              </div>

              <div class="card-gradient-border rounded-xl p-5 transition-all duration-300 group-hover:bg-stone-900/60">
                {
                  item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-lg font-medium text-stone-100 transition group-hover:text-white"
                    >
                      {item.company}
                      <span class="ml-1 inline-block text-stone-600 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                    </a>
                  ) : (
                    <h3 class="text-lg font-medium text-stone-100">{item.company}</h3>
                  )
                }
                <p class="mt-1 font-mono text-sm text-[rgb(var(--accent)_/_0.7)]">{item.role}</p>
                <p class="mt-3 text-base leading-relaxed text-stone-400">{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
