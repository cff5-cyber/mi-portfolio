---
import { experience } from '../data/site';
---

<section id="experience" class="border-t border-stone-800/80">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="text-sm font-medium tracking-wide text-stone-500 uppercase">Experiencia</h2>
    <div class="mt-10 space-y-10">
      {
        experience.map((item) => (
          <article class="group grid gap-2 md:grid-cols-[200px_1fr] md:gap-8">
            <div>
              <p class="text-sm text-stone-600">{item.period}</p>
            </div>
            <div>
              {
                item.url ? (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg font-medium text-stone-100 transition group-hover:text-stone-400"
                  >
                    {item.company}
                    <span class="ml-1 inline-block text-stone-600">↗</span>
                  </a>
                ) : (
                  <h3 class="text-lg font-medium text-stone-100">{item.company}</h3>
                )
              }
              <p class="mt-1 text-sm text-stone-500">{item.role}</p>
              <p class="mt-3 text-base leading-relaxed text-stone-400">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
