---
import { about } from '../data/site';

const icons = ['💡', '🚀'];
---

<section id="about" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="font-mono text-sm font-medium tracking-wide text-[rgb(var(--accent))] uppercase">Sobre mí</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8">
      {
        about.paragraphs.map((paragraph, i) => (
          <div class="glass group rounded-2xl p-6 transition-all duration-300 hover:border-stone-600/40 hover:shadow-lg hover:shadow-black/10">
            <span class="mb-4 block text-2xl" aria-hidden="true">{icons[i]}</span>
            <p class="text-base leading-relaxed text-stone-400 transition-colors group-hover:text-stone-300">
              {paragraph}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
