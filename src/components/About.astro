---
import { about } from '../data/site';
---

<section id="about" class="border-t border-stone-800/80 bg-stone-900/40">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="text-sm font-medium tracking-wide text-stone-500 uppercase">Sobre mí</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2 md:gap-12">
      {
        about.paragraphs.map((paragraph) => (
          <p class="text-base leading-relaxed text-stone-400">{paragraph}</p>
        ))
      }
    </div>
  </div>
</section>
