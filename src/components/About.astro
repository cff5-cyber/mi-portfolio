---
import { about } from '../data/site';

const icons = ['💡', '🚀'];
---

<section id="about" class="section-divider">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
    <h2 class="font-mono text-sm font-semibold tracking-wider text-[rgb(var(--accent))] uppercase">Sobre mí</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2 md:gap-8">
      {
        about.paragraphs.map((paragraph, i) => (
          <div class="glass group rounded-2xl p-6 transition-all duration-300 hover:border-[rgb(var(--accent)_/_0.4)] hover:shadow-lg hover:shadow-[rgb(var(--accent)_/_0.08)]">
            <span class="mb-4 block text-3xl" aria-hidden="true">{icons[i]}</span>
            <p class="text-base leading-relaxed text-[var(--text-muted)] transition-colors group-hover:text-[var(--text-main)]">
              {paragraph}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
