---
import { site, navLinks } from '../data/site';
---

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4">
  <nav class="glass flex max-w-3xl items-center gap-1 rounded-full px-2 py-2 shadow-lg shadow-black/20 sm:gap-2 sm:px-4">
    <a
      href="#"
      class="shrink-0 px-3 py-1.5 text-sm font-semibold tracking-tight text-stone-100 transition hover:text-white"
    >
      {site.name.split(' ')[0]}<span class="text-stone-500">.</span>
    </a>

    <div class="mx-1 h-4 w-px bg-stone-700/50 sm:mx-2"></div>

    <ul class="flex items-center gap-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-1.5 text-sm text-stone-400 transition hover:bg-stone-800/60 hover:text-stone-100"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mx-1 h-4 w-px bg-stone-700/50 sm:mx-2"></div>

    <a
      href={site.cvUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-stone-200 transition hover:bg-white/20 hover:text-white"
    >
      CV ↓
    </a>
  </nav>
</header>
