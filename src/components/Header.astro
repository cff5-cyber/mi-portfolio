---
import { site, navLinks } from '../data/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-stone-800/60 bg-stone-950/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4 md:flex-nowrap">
    <a
      href="#"
      class="text-sm font-semibold tracking-tight text-stone-100 transition hover:text-stone-400"
    >
      {site.name.split(' ')[0]} <span class="text-stone-500">{site.name.split(' ').slice(1).join(' ')}</span>
    </a>

    <ul class="order-3 flex w-full gap-6 overflow-x-auto pb-1 md:order-none md:w-auto md:overflow-visible">
      {
        navLinks.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class="text-sm text-stone-500 transition hover:text-stone-100"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={site.cvUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-stone-700 px-4 py-1.5 text-sm font-medium text-stone-300 transition hover:border-stone-400 hover:text-stone-100"
    >
      CV
    </a>
  </nav>
</header>
